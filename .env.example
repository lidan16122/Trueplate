# Copy to `.env` at the repo root. Never commit the real file.
# docker-compose reads this, and the FastAPI app resolves it from the repo root
# regardless of the working directory it was launched from.

# ---------- Postgres ----------
POSTGRES_USER=trueplate
POSTGRES_PASSWORD=trueplate
POSTGRES_DB=trueplate
POSTGRES_PORT=5432

# SQLAlchemy async URL. Driver is psycopg3 (not asyncpg).
#
# The port here is NOT derived from POSTGRES_PORT above — compose reads that one,
# the app reads this one. Change one without the other (say, to dodge a Postgres
# you already run on 5432) and the container moves while the app keeps dialling
# the old port. Same applies to REDIS_PORT and REDIS_URL below.
DATABASE_URL=postgresql+psycopg://trueplate:trueplate@localhost:5432/trueplate

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- Auth ----------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Set false only if your browser rejects Secure cookies over plain http.
# Chrome and Firefox both treat http://localhost as a trustworthy origin,
# so `true` normally works fine in local development.
COOKIE_SECURE=true

# Only consulted for cross-origin requests. In dev the Vite proxy makes the
# browser see the API as same-origin, so this stays unused.
CORS_ORIGINS=http://localhost:5173

# ---------- Google Sign-In ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). See README for the walkthrough.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---------- Anthropic (AI food detection) ----------
# console.anthropic.com -> API keys. Without this the detect routes return 503
# rather than failing somewhere deeper.
ANTHROPIC_API_KEY=sk-ant-...

# Opus 5. Vision runs at the high-resolution tier and thinking is on by default,
# so ANTHROPIC_MAX_TOKENS caps thinking *and* the reply together.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=8000
# The main per-photo cost lever. low | medium | high | xhigh | max
# ANTHROPIC_EFFORT=medium
# Long edge in pixels before upload. Opus 5 accepts up to 2576, but a
# full-resolution image costs roughly 3x the tokens of one this size.
# DETECT_IMAGE_MAX_EDGE_PX=1568

# ---------- Nutrition data sources ----------
# Free, instant, no approval step: https://fdc.nal.usda.gov/api-key-signup.html
#
# This one matters more than it looks. Without a valid key the resolver still
# works — it falls through to Open Food Facts — but OFF is a barcode database
# searched by name, so generic foods like "rolled oats" or "sweet potato" either
# miss entirely or match a branded product with quite different numbers. Those
# always surface as "Rough guess" and are never written back, so nothing
# silently breaks; the app just gets noticeably worse at ordinary food.
USDA_FDC_API_KEY=your-usda-fdc-key

# Open Food Facts asks that clients identify themselves. An anonymous client is
# what gets blocked.
# OPEN_FOOD_FACTS_USER_AGENT=Trueplate/0.1 (https://github.com/lidan16122/Trueplate)

# ---------- Datastore timeouts ----------
# The defaults suit a local container, where a dead dependency should surface in
# seconds. Managed instances need more headroom: a free-tier Neon or Upstash
# scales to zero and the first request after an idle period pays a cold start,
# which the tight defaults read as an outage.
#
# Uncomment these when pointing at Neon / Upstash rather than docker-compose:
# DB_CONNECT_TIMEOUT_SECONDS=15
# DB_STATEMENT_TIMEOUT_SECONDS=30
# REDIS_TIMEOUT_SECONDS=10
# HEALTH_CHECK_TIMEOUT_SECONDS=20.0

# ---------- Optional ----------
# Instant access-token revocation. Off by default: the normal path verifies the
# JWT by signature only and never touches Redis.
ACCESS_DENYLIST_ENABLED=false
LOG_LEVEL=INFO
