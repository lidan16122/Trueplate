# Copy to server/.env for FastAPI and Alembic.
# For Docker Compose, also copy to the root .env; it reads POSTGRES_* and REDIS_PORT.
# Keep real credentials in server/.env. Neither real file belongs in version control.

# ---------- Local PostgreSQL / Redis ----------
POSTGRES_USER=trueplate
POSTGRES_PASSWORD=trueplate
POSTGRES_DB=trueplate
POSTGRES_PORT=5432
REDIS_PORT=6379

# These URLs are independent of the variables above; keep credentials and ports aligned.
# Managed PostgreSQL needs the postgresql+psycopg:// scheme and provider TLS options.
DATABASE_URL=postgresql+psycopg://trueplate:trueplate@localhost:5432/trueplate
# Use rediss:// when the Redis provider requires TLS.
REDIS_URL=redis://localhost:6379/0

# ---------- Auth ----------
# Required: generate from the repo root, then paste the result below.
# uv run --directory server python -c "import secrets; print(secrets.token_urlsafe(64))"
# The API and migrations refuse an empty key or one shorter than 32 characters.
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=1

# Keep true for HTTPS deployments. Use false only for local HTTP if cookies are rejected.
COOKIE_SECURE=true
# The default frontend proxy is same-origin; this allowlist is for cross-origin requests.
CORS_ORIGINS=http://localhost:5173
ACCESS_DENYLIST_ENABLED=false

# ---------- Google Sign-In ----------
# Required for sign-in. Create a Google OAuth Web application client; see README.
# Register this exact frontend callback in Google, and keep the secret server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
# GOOGLE_TIMEOUT_SECONDS=10.0

# ---------- Anthropic food recognition ----------
# Required for photo/text detection; leave empty to keep those integrations unavailable.
# Use an Anthropic API key with credits and access to the configured model.
ANTHROPIC_API_KEY=

# Optional overrides below match app/config.py defaults.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=8000
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_TIMEOUT_SECONDS=120.0
# Overview resolution controls visual tokens. Set 1568 to compare with the old size.
# DETECT_IMAGE_MAX_EDGE_PX=1024
# Crops use original pixels and never upscale a smaller region.
# DETECT_IMAGE_CROP_MAX_EDGE_PX=768
# Quality controls upload bytes; compare it separately from resolution.
# DETECT_IMAGE_JPEG_QUALITY=88
# Upload byte limit, shared by meal and barcode photos (8 MiB).
# DETECT_IMAGE_MAX_BYTES=8388608

# Photo, text, and barcode requests share this per-user window.
# The separate account allowance is users.max_prompts in PostgreSQL, not an env setting.
# AI_DETECT_RATE_LIMIT=20
# AI_DETECT_RATE_WINDOW_SECONDS=3600

# The grounded response is a separate, bounded pass after recognition and retrieval.
# GROUNDING_TIMEOUT_SECONDS=20
# GROUNDING_MAX_TOKENS=2000

# Web search helps identify foods; nutrition values still come from source records.
# WEB_SEARCH_MAX_USES=3
# WEB_SEARCH_ALLOWED_DOMAINS=fdc.nal.usda.gov,world.openfoodfacts.org,en.wikipedia.org

# ---------- Nutrition data ----------
# Obtain a key at https://fdc.nal.usda.gov/api-key-signup.html.
# Without it, matching uses existing records and Open Food Facts with reduced coverage.
USDA_FDC_API_KEY=

# Open Food Facts needs no API key; its client identifies itself with this user agent.
# OPEN_FOOD_FACTS_USER_AGENT=Trueplate/0.1 (https://github.com/lidan16122/Trueplate)
# USDA_FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1
# OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
# NUTRITION_TIMEOUT_SECONDS=10.0

# Only sufficiently confident matches are written to the shared food reference.
# FOODS_WRITEBACK_MIN_CONFIDENCE=0.75
# Cache expiry refreshes reference data and detections, leaving saved food entries unchanged.
# Model, effort, and prompt/schema changes also produce new detection cache keys.
# FOODS_TTL_DAYS=30
# DETECTIONS_TTL_DAYS=30

# ---------- Datastore timeouts ----------
# Local defaults, in seconds.
# DB_CONNECT_TIMEOUT_SECONDS=3
# DB_STATEMENT_TIMEOUT_SECONDS=10
# REDIS_TIMEOUT_SECONDS=2
# HEALTH_CHECK_TIMEOUT_SECONDS=3.0

# Managed-service overrides: use these instead of the local values if wake-up is slow.
# DB_CONNECT_TIMEOUT_SECONDS=15
# DB_STATEMENT_TIMEOUT_SECONDS=30
# REDIS_TIMEOUT_SECONDS=10
# HEALTH_CHECK_TIMEOUT_SECONDS=20.0

# ---------- Logging ----------
LOG_LEVEL=INFO
# DB_ECHO=false

# See server/app/config.py for the full settings list.
