# The load-bearing line: without it the Windows virtualenv is copied into a Linux
# image and shadows the one `uv sync` builds.
.venv/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Never bake secrets into an image. Render supplies real environment variables,
# and app/config.py would not look here for a .env anyway.
.env
.env.*

# Not reachable from app/ — a serving process imports none of it.
tests/

# Same reasoning as tests/, and one step more pointed: this file hardcodes a
# JWT_SECRET_KEY so the suite can collect without a .env. Nothing outside pytest
# imports it, but a published signing key does not belong in an image whose
# security rests on that variable being secret.
conftest.py
