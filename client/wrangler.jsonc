// Cloudflare Workers deployment for the built client.
//
// Two jobs: serve ./dist from the edge, and forward /api to the deployed API so
// the browser only ever sees one origin. The second is what keeps the
// SameSite=lax auth cookies working — worker/index.ts carries the full reasoning.
{
  "name": "trueplate",
  // Pins the Workers runtime behaviour to how it worked on this date, so a
  // future platform change cannot alter the deployment without a deliberate bump.
  "compatibility_date": "2026-08-25",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/",
    // A client-side router owns every path, so an unmatched request is a route
    // React Router should resolve, not a missing file. Without this, a hard
    // refresh on /progress returns a 404 from the edge and the app never boots.
    "not_found_handling": "single-page-application",
    // Only /api reaches the Worker. Every other request is served straight off
    // the asset path without invoking it, so the proxy costs nothing on the
    // requests that make up almost all of the traffic.
    "run_worker_first": ["/api/*"],
    // Lets the Worker fall back to the assets for anything that reaches it
    // outside the rule above.
    "binding": "ASSETS"
  },

  // Keeps the Render instance from sleeping. Ten minutes against Render's
  // fifteen-minute idle window: the margin is the point, absorbing a tick that
  // Cloudflare delays without the instance reaching the spin-down threshold.
  // worker/index.ts carries what actually goes wrong when it does sleep, and the
  // README the instance-hour accounting.
  //
  // This string is the dial. "*/10 6-23 * * *" leaves six of the twenty-four
  // hours cold, so it saves about a quarter of the bill and costs a slow first
  // sign-in of the morning. Crons run in UTC, not the user's timezone.
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
